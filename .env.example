# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Managed MySQL database (Vercel cannot connect to a MySQL server on your PC)
DB_HOST=your-database-host
DB_PORT=3306
DB_USER=your-database-user
DB_PASS=your-database-password
DB_NAME=personal_trainer_db
# Set to true only when your database provider requires TLS.
DB_SSL=false

# Authentication and third-party services
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id
EMAIL_USER=your-gmail-address
EMAIL_PASS=your-gmail-app-password
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Created automatically when a Vercel Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token
